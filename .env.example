# Sample variable names for the MooTrade application's own configuration.
# These are NOT guaranteed to be the official Qoder/Moomoo provider fields.
APP_ENV=development
TRADING_MODE=paper_only
ORDER_WRITES_ENABLED=false
DATABASE_URL=sqlite:///./data/mootrade.db
DASHBOARD_ORIGIN=http://localhost:3000

# Read-only dashboard API. Leave the token empty for loopback-only development.
MOOTRADE_DASHBOARD_TOKEN=
# Target used by the Next.js server proxy; never sent to the browser.
MOOTRADE_API_URL=http://127.0.0.1:8000

# Populate only when required and after verifying provider instructions.
# QODER_ACCESS_TOKEN=
# QODER_PAT=
# MOOMOO_MCP_URL=

# Exact competition-account lock: masked id + SHA-256 fingerprint of the full acc_id.
# Generate the fingerprint without echoing the id: python -m app.cli fingerprint-account
COMPETITION_ACCOUNT_MASKED_ID=****0000
COMPETITION_ACCOUNT_FINGERPRINT=
COMPETITION_ACCOUNT_MARKET_ID=100

# Optional local OAuth token file. Defaults to %LOCALAPPDATA%\MooTrade\moomoo-oauth.bin
# on Windows. Keep it outside the repository; Windows protects it with DPAPI.
# MOOTRADE_OAUTH_STORE=

# Separate execution token for the supervised CLI. Defaults to
# %LOCALAPPDATA%\MooTrade\moomoo-execution-oauth.bin. Never reuse the read token.
# MOOTRADE_EXECUTION_OAUTH_STORE=

# Never commit a populated .env file.
